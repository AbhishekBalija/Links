# Production uses relative /api requests through Vercel Services.
# No VITE_API_URL is required.
# Google sign-in's OAuth client ID (public), the same value as the server's
# GOOGLE_CLIENT_ID. Set it for Production only: preview URLs can't be listed
# as Google origins, so previews sign in with an email code.
VITE_GOOGLE_CLIENT_ID=233860164104-6df77kvdio1sj189jrblv4vcqfotg8g0.apps.googleusercontent.com

# Sentry error reporting (public DSN). Leave empty to turn it off.
VITE_SENTRY_DSN=
# Lets the build upload source maps to Sentry. A secret: set it in Vercel
# only, never commit a real value. Leave unset to skip the upload.
SENTRY_AUTH_TOKEN=
