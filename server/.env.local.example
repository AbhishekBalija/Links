# Local development environment.
# Copy this to server/.env.local and adjust values for your machine.

APP_ENV=local
APP_PORT=8080
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=linksdb
DB_SSLMODE=disable

# Test-only sign-in by email alone, for the e2e suite (Playwright sets it).
# Never set it on a shared server; it is refused unless APP_ENV=local.
ENABLE_TEST_SIGN_IN=false

# Frontend URL: the web app's origin, allowed to use the refresh cookie
FRONTEND_URL=http://localhost:5173

# Google sign-in's OAuth Web client ID (public, not a secret).
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=233860164104-6df77kvdio1sj189jrblv4vcqfotg8g0.apps.googleusercontent.com

# Resend API key for sign-in code emails
# Leave empty to use NoopMailer (no emails sent)
RESEND_API_KEY=
# Verified sender email (local: onboarding@resend.dev, prod: noreply@<domain>)
FROM_EMAIL=onboarding@resend.dev

