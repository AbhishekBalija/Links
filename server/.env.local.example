# Local development environment.
# Copy this to server/.env.local and adjust values for your machine.

APP_ENV=local
APP_PORT=8080
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=linksdb
DB_SSLMODE=disable

# Test-only sign-in by email alone, for the e2e suite (Playwright sets it).
# Never set it on a shared server; it is refused unless APP_ENV=local.
ENABLE_TEST_SIGN_IN=false

# How email is sent: resend (production) or smtp. With smtp, every email goes
# to that server, for example a Mailtrap testing inbox that keeps them all.
MAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Let the principal and admins sign in with an email code too, for testing
# with throwaway inboxes. Refused with APP_ENV=production.
EMAIL_CODE_FOR_EVERY_ROLE=false

# Sign-in codes sent in a day to emails on no list (people asking to join),
# across the whole copy. Raise it for orientation day if the email service
# allows; the default protects a small daily quota.
NOT_ON_LIST_CODES_PER_DAY=50

# Sign-in codes from one network address in 15 minutes. A whole campus shares
# one Wi-Fi address, so raise it for a large college's first day.
CODES_PER_NETWORK_PER_15_MIN=600

# Frontend URL: the web app's origin, allowed to use the refresh cookie
FRONTEND_URL=http://localhost:5173

# Google sign-in's OAuth Web client ID (public, not a secret).
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=233860164104-6df77kvdio1sj189jrblv4vcqfotg8g0.apps.googleusercontent.com

# Resend API key for sign-in code emails
# Leave empty to use NoopMailer (no emails sent)
RESEND_API_KEY=
# Verified sender email (local: onboarding@resend.dev, prod: noreply@<domain>)
FROM_EMAIL=onboarding@resend.dev


# Signing secrets for sign-in tokens. The server will not start without them.
# These are throwaway local values; never reuse them anywhere shared.
# Generate your own with: openssl rand -base64 48
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me

# How long sign-in tokens last (Go durations: 15m, 24h). Defaults shown.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Refresh cookie. COOKIE_SECURE may be false only with APP_ENV=local.
# COOKIE_SAME_SITE is lax or strict.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Web app origins allowed to call the API, comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Largest request body the API accepts, in bytes (default 1 MiB).
REQUEST_BODY_LIMIT=1048576

# Database connection pool (defaults shown).
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=45m
DB_CONN_MAX_IDLE_TIME=5m

# Instead of the DB_* settings above, one connection string works too.
# DATABASE_URL=postgresql://postgres@localhost:5432/linksdb

# Overrides APP_PORT when set (a host such as Vercel sets it for you).
# PORT=

# Sentry error reporting. Leave empty to turn it off.
SENTRY_DSN=
