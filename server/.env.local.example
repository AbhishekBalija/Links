# Local development environment.
# Copy this to server/.env.local and adjust values for your machine.

APP_ENV=local
APP_PORT=8080
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=linksdb
DB_SSLMODE=disable

# Frontend URL for CORS and activation links
FRONTEND_URL=http://localhost:5173

# Resend API key for transactional emails
# Leave empty to use NoopMailer (no emails sent)
RESEND_API_KEY=
# Verified sender email (local: onboarding@resend.dev, prod: noreply@<domain>)
FROM_EMAIL=onboarding@resend.dev

