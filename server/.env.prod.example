# Production environment template.
# Do not put real secrets in this file.
# Set these values in the Vercel project environment settings.

GIN_MODE=release
# Turns on HSTS and the check that the refresh cookie is Secure.
APP_ENV=production

# PostgreSQL connection string (required)
DATABASE_URL=

# Frontend URL for activation/email links.
# Optional on Vercel — falls back to VERCEL_PROJECT_PRODUCTION_URL (production)
# or VERCEL_URL (preview). Only set this if you need a custom domain override.
# FRONTEND_URL=

# Vercel provides PORT automatically.
# PORT=

# Google sign-in's OAuth Web client ID (public, not a secret).
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=233860164104-6df77kvdio1sj189jrblv4vcqfotg8g0.apps.googleusercontent.com

# Resend API key (Sending Access key scoped to prod)
RESEND_API_KEY=

# Must be a verified sending domain in Resend (required — sandbox sender
# @resend.dev will NOT work in production).
FROM_EMAIL=noreply@<domain>

# Sign-in codes sent in a day to emails on no list (people asking to join),
# across the whole copy. Raise it for orientation day if the email service
# allows; the default protects a small daily quota.
NOT_ON_LIST_CODES_PER_DAY=50

# Sign-in codes from one network address in 15 minutes. A whole campus shares
# one Wi-Fi address, so raise it for a large college's first day.
CODES_PER_NETWORK_PER_15_MIN=600

# Generate via: openssl rand -base64 48
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# How email is sent: resend (default) or smtp. With smtp, production also
# needs the SMTP_* settings below.
# MAIL_PROVIDER=resend
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# How long sign-in tokens last (Go durations). Defaults shown.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=168h

# Refresh cookie. COOKIE_SECURE must stay true outside APP_ENV=local.
# COOKIE_SAME_SITE is lax or strict.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Web app origins allowed to call the API, comma separated. Set it only if
# the web app is served from a different origin than the API.
# CORS_ALLOWED_ORIGINS=

# Largest request body the API accepts, in bytes (default 1 MiB).
# REQUEST_BODY_LIMIT=1048576

# Database connection pool (defaults shown).
# DB_MAX_OPEN_CONNS=15
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=45m
# DB_CONN_MAX_IDLE_TIME=5m

# Sentry error reporting. Leave empty to turn it off.
SENTRY_DSN=
