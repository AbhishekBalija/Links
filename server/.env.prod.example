# Production environment template.
# Do not put real secrets in this file.
# Set these values in the Vercel project environment settings.

GIN_MODE=release
# Turns on HSTS and the check that the refresh cookie is Secure.
APP_ENV=production

# PostgreSQL connection string (required)
DATABASE_URL=

# Frontend URL for activation/email links.
# Optional on Vercel — falls back to VERCEL_PROJECT_PRODUCTION_URL (production)
# or VERCEL_URL (preview). Only set this if you need a custom domain override.
# FRONTEND_URL=

# Vercel provides PORT automatically.
# PORT=

# Google sign-in's OAuth Web client ID (public, not a secret).
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=233860164104-6df77kvdio1sj189jrblv4vcqfotg8g0.apps.googleusercontent.com

# Resend API key (Sending Access key scoped to prod)
RESEND_API_KEY=

# Must be a verified sending domain in Resend (required — sandbox sender
# @resend.dev will NOT work in production).
FROM_EMAIL=noreply@<domain>

# Generate via: openssl rand -base64 48
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
